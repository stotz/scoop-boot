# ============================================================================
# KOTLIN
# ============================================================================
KOTLIN_HOME=$USR\apps\kotlin\current
PATH+=$KOTLIN_HOME\bin

# ============================================================================
# JAVA DEVELOPMENT & BUILD TOOLS
# ============================================================================
ANT_HOME=$USR\apps\ant\current
PATH+=$ANT_HOME\bin

GRADLE_HOME=$USR\apps\gradle\current
PATH+=$GRADLE_HOME\bin
GRADLE_USER_HOME=$USERPROFILE\.gradle
GRADLE_OPTS=-Xmx2048m -Dorg.gradle.daemon=true -Dorg.gradle.parallel=true

MAVEN_HOME=$USR\apps\maven\current
PATH+=$MAVEN_HOME\bin
M2_HOME=$MAVEN_HOME
# Informational only (IDE convention). Maven itself reads <localRepository> in
# settings.xml or -Dmaven.repo.local; see the cache section at the end.
M2_REPO=$USERPROFILE\.m2\repository
MAVEN_OPTS=-Xmx1024m -XX:+TieredCompilation -XX:TieredStopAtLevel=1

JAVA_HOME=$USR\apps\temurin25-jdk\current
PATH+=$JAVA_HOME\bin
JAVA_OPTS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
# Toolchain location in setup-java naming. Older JDKs come with the profiles java8,
# java11, java17 and java21, each with its own JAVA_HOME_NN_X64 and without a PATH
# entry. Gradle reads them with org.gradle.java.installations.fromEnv=JAVA_HOME_17_X64,...
# in gradle.properties; Maven needs toolchains.xml; IntelliJ takes the path as an SDK.
JAVA_HOME_25_X64=$USR\apps\temurin25-jdk\current
