# ============================================================================
# C/C++ DEVELOPMENT
# ============================================================================
MAKE_HOME=$USR\apps\make\current
PATH+=$MAKE_HOME\bin

CMAKE_HOME=$USR\apps\cmake\current
PATH+=$CMAKE_HOME\bin

# ============================================================================
# MSYS2
# usr\bin (bash, pacman, coreutils) is appended: lowest priority, behind Git's
# usr\bin and behind System32, so that its extensionless find, sort and friends
# never shadow the Windows programs.
# ucrt64\bin (gcc and its DLLs) is prepended, and this profile comes after perl
# in profiles.conf on purpose: it must be in front of Git (mingw64\bin) and Perl
# (perl\bin) in the PATH. Both ship their own libstdc++-6.dll, libgcc_s_seh-1.dll,
# libwinpthread-1.dll and zlib1.dll built with older GCC/msvcrt; if those are
# found first, cc1.exe fails with STATUS_ENTRYPOINT_NOT_FOUND (exit -1073741511)
# and gcc produces nothing.
# ============================================================================
MSYS2_HOME=$USR\apps\msys2\current
PATH=+$MSYS2_HOME\usr\bin
PATH+=$MSYS2_HOME\ucrt64\bin
