# ============================================================================
# System Environment Configuration
# Save this file as system.<hostname>.<username>.env (both lowercase), e.g.
#   system.$($env:COMPUTERNAME.ToLower()).$($env:USERNAME.ToLower()).env
# File: system.hostname.username.env
# Created: 2025-12-12 04:23:00
# Updated: 2026-10-20 (SVN via TortoiseSVN, DATA/DEVL_ROOT, optional cache relocation)
# ============================================================================
# Scope: Machine (requires admin)
# SCOOP: C:\usr
# Hostname: <hostname>
# Username: <username>
# ============================================================================

# ============================================================================
# NOTE ON CLEANUP
# No PATH-= lines are needed for Scoop directories: --apply-env sweeps every
# Machine PATH entry inside apps\, shims\, persist\, global\ before this file is
# applied, and --clean-user-scope does the same for the User PATH. Use PATH-= only
# for entries outside those directories that you want gone.
# ============================================================================

# ============================================================================
# MSYS2 Unix tools - LOW PRIORITY (fallback behind Git's usr\bin)
# The UCRT64 compiler directory is added further down with HIGH priority.
# ============================================================================
MSYS2_HOME=C:\usr\apps\msys2\current
PATH+=$MSYS2_HOME\usr\bin

# ============================================================================
# VERSION CONTROL
# ============================================================================
SVN_HOME=C:\usr\apps\tortoisesvn\current
PATH+=$SVN_HOME\bin

GIT_HOME=C:\usr\apps\git\current
PATH+=$GIT_HOME\mingw64\bin
PATH+=$GIT_HOME\usr\bin
PATH+=$GIT_HOME\cmd
GIT_SSH=C:\usr\apps\openssh\current\ssh.exe

# ============================================================================
# C/C++ DEVELOPMENT
# ============================================================================
MAKE_HOME=C:\usr\apps\make\current
PATH+=$MAKE_HOME\bin

CMAKE_HOME=C:\usr\apps\cmake\current
PATH+=$CMAKE_HOME\bin

# ============================================================================
# NODE.JS DEVELOPMENT
# ============================================================================
NODE_HOME=C:\usr\apps\nodejs\current
PATH+=$NODE_HOME
NODE_PATH=$NODE_HOME\node_modules
NPM_CONFIG_PREFIX=C:\usr\persist\nodejs
PATH+=$NPM_CONFIG_PREFIX\bin

# ============================================================================
# PERL DEVELOPMENT
# ============================================================================
PERL_HOME=C:\usr\apps\perl\current
PATH+=$PERL_HOME\perl\site\bin
PATH+=$PERL_HOME\perl\bin
PERL5LIB=$PERL_HOME\perl\lib;$PERL_HOME\perl\site\lib

# ============================================================================
# PYTHON DEVELOPMENT
# ============================================================================
PYTHON_HOME=C:\usr\apps\python314\current
PATH+=$PYTHON_HOME\Scripts
PATH+=$PYTHON_HOME
PYTHONPATH=$PYTHON_HOME\Lib\site-packages

# ============================================================================
# KOTLIN DEVELOPMENT
# ============================================================================
KOTLIN_HOME=C:\usr\apps\kotlin\current
PATH+=$KOTLIN_HOME\bin

# ============================================================================
# JAVA DEVELOPMENT & BUILD TOOLS
# ============================================================================
ANT_HOME=C:\usr\apps\ant\current
PATH+=$ANT_HOME\bin

GRADLE_HOME=C:\usr\apps\gradle\current
PATH+=$GRADLE_HOME\bin
GRADLE_USER_HOME=$USERPROFILE\.gradle
GRADLE_OPTS=-Xmx2048m -Dorg.gradle.daemon=true -Dorg.gradle.parallel=true

MAVEN_HOME=C:\usr\apps\maven\current
PATH+=$MAVEN_HOME\bin
M2_HOME=$MAVEN_HOME
# Informational only (IDE convention). Maven itself reads <localRepository> in
# settings.xml or -Dmaven.repo.local; see the cache section at the end.
M2_REPO=$USERPROFILE\.m2\repository
MAVEN_OPTS=-Xmx1024m -XX:+TieredCompilation -XX:TieredStopAtLevel=1

JAVA_HOME=C:\usr\apps\temurin25-jdk\current
PATH+=$JAVA_HOME\bin
JAVA_OPTS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
# Toolchain locations in setup-java naming. Only JDK 25 is installed by scoop-boot;
# the others resolve once someone runs "scoop install temurinNN-jdk".
# Gradle reads them only with org.gradle.java.installations.fromEnv=JAVA_HOME_8_X64,...
# in gradle.properties (missing paths give a warning, not an error); Maven needs
# toolchains.xml; IntelliJ ignores them.
JAVA_HOME_8_X64=C:\usr\apps\temurin8-jdk\current
JAVA_HOME_11_X64=C:\usr\apps\temurin11-jdk\current
JAVA_HOME_17_X64=C:\usr\apps\temurin17-jdk\current
JAVA_HOME_21_X64=C:\usr\apps\temurin21-jdk\current
JAVA_HOME_25_X64=C:\usr\apps\temurin25-jdk\current

# ============================================================================
# C/C++ COMPILER (MSYS2 UCRT64) - HIGH PRIORITY
# Must come before Git (mingw64\bin) and Perl (perl\bin): both ship their own
# libstdc++-6.dll, libgcc_s_seh-1.dll, libwinpthread-1.dll and zlib1.dll built
# with older GCC/msvcrt. If they are found first, cc1.exe fails with
# STATUS_ENTRYPOINT_NOT_FOUND (exit -1073741511) and gcc produces nothing.
# ============================================================================
PATH+=$MSYS2_HOME\ucrt64\bin

# ============================================================================
# CORE PATHS - HIGHEST PRIORITY (at the bottom!)
# ============================================================================
PATH+=$SCOOP\shims
PATH+=$SCOOP\bin

# ============================================================================
# LOCALE & ENCODING
# ============================================================================
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
LANGUAGE=en_US:en

# ============================================================================
# CUSTOM
# ============================================================================
TMP=C:\tmp
TEMP=C:\tmp
USR=C:\usr
DATA=C:\data
DEVL_ROOT=C:\devl

# ============================================================================
# OPTIONAL: CACHES OUTSIDE THE USER PROFILE
# ============================================================================
# By default every tool keeps its cache under %USERPROFILE% (.gradle, .m2,
# AppData\Local\npm-cache, AppData\Local\pip\Cache, JetBrains indexes, NuGet,
# WSL disks). On a workstation that is fine. On a roaming or container profile
# (FSLogix, roaming profiles, profile size quotas) those caches are copied at
# every logon and can fill the quota; a 2 GB Gradle cache and a 20 GB WSL disk
# do not belong there.
#
# How to use: remove the leading "#" from the lines you want, keep CACHES as the
# common root, then run Phase 1 again (scoop-complete-install.ps1 -SetEnvironment,
# as Administrator) and open a new shell. Tools create their directories on first
# use and simply download again; the old caches under %USERPROFILE% can be
# deleted afterwards. Lines that redefine a variable set above (GRADLE_USER_HOME,
# MAVEN_OPTS) replace that value when uncommented. Everything that is not an
# environment variable (JetBrains, Docker, WSL) is a one-time command or setting,
# listed at the end.
#
#CACHES=$DATA\caches
#
# Gradle: whole user home (wrapper distributions, dependency cache, daemon logs)
#GRADLE_USER_HOME=$CACHES\gradle
#
# Maven: local repository. Maven ignores M2_REPO; the switch is this JVM option
# (or <localRepository> in ~\.m2\settings.xml). Replaces the MAVEN_OPTS line above.
#MAVEN_OPTS=-Xmx1024m -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -Dmaven.repo.local=$CACHES\m2\repository
#
# Node: npm download cache (global packages are already under NPM_CONFIG_PREFIX)
#NPM_CONFIG_CACHE=$CACHES\npm
#YARN_CACHE_FOLDER=$CACHES\yarn
#
# Python: pip wheel/http cache
#PIP_CACHE_DIR=$CACHES\pip
#
# vcpkg: binary cache (downloads and buildtrees are persisted under C:\usr already)
#VCPKG_DEFAULT_BINARY_CACHE=$CACHES\vcpkg
#
# .NET / Visual Studio / NuGet: package folder, http cache, dotnet tools home
#NUGET_PACKAGES=$CACHES\nuget\packages
#NUGET_HTTP_CACHE_PATH=$CACHES\nuget\http
#NUGET_PLUGINS_CACHE_PATH=$CACHES\nuget\plugins
#DOTNET_CLI_HOME=$CACHES\dotnet
#
# Go and Rust (if installed later)
#GOPATH=$CACHES\go
#GOMODCACHE=$CACHES\go\pkg\mod
#GOCACHE=$CACHES\go\build
#CARGO_HOME=$CACHES\cargo
#RUSTUP_HOME=$CACHES\rustup
#
# Kotlin/Native toolchains
#KONAN_DATA_DIR=$CACHES\konan
#
# JetBrains IDEs: indexes and caches live in %LOCALAPPDATA%\JetBrains\<Product>.
# Each IDE reads a properties file named by its own variable (IDEA_PROPERTIES,
# RIDER_PROPERTIES, PYCHARM_PROPERTIES, WEBSTORM_PROPERTIES, CLION_PROPERTIES,
# GOLAND_PROPERTIES, DATAGRIP_PROPERTIES). Create one file per product, e.g.
# C:\data\caches\jetbrains\rider.properties with the lines
#   idea.system.path=C:/data/caches/jetbrains/rider/system
#   idea.log.path=C:/data/caches/jetbrains/rider/log
# (idea.config.path and idea.plugins.path can stay in the profile, they are small
# and hold your settings). The IDE binaries themselves are already under
# C:\usr\apps\jetbrains-toolbox\current\apps.
#IDEA_PROPERTIES=$CACHES\jetbrains\idea.properties
#RIDER_PROPERTIES=$CACHES\jetbrains\rider.properties
#
# WSL distributions (incl. Docker Desktop and Rancher Desktop data disks): the
# VHDX is under %LOCALAPPDATA% and is the largest single item. Move it once with
# WSL 2.1 or newer (stop everything first):
#   wsl --shutdown
#   wsl --manage <distro> --move C:\data\wsl\<distro>
#   (names: wsl --list --verbose; Rancher Desktop uses rancher-desktop and
#    rancher-desktop-data, Docker Desktop uses docker-desktop and docker-desktop-data)
# Docker Desktop alternatively: Settings > Resources > Advanced > Disk image location.
