# EditorConfig: https://editorconfig.org
# Read by Rider/IntelliJ, VS Code, Visual Studio and others. Keeps line endings LF
# in the editor so that Git never sees CRLF.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
