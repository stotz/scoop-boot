# Normalize all text files to LF in the repository and in the working tree.
# Overrides any core.autocrlf setting of the client.
* text=auto eol=lf

# Binary files: never normalize
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.7z   binary
*.bz2  binary
*.gz   binary
*.exe  binary
*.dll  binary
*.msi  binary
